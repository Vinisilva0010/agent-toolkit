[222.588641, "o", "\u001b[7mgit add -A\u001b[27m\r\n\r\u001b[7mgit commit -m \"fix(cli): extract plain text from MCP tool content and suppress noisy warnings\u001b[27m\r\n\r\n\r\u001b[7mmain.py was printing the raw MCP content blocks (including the\u001b[27m\r\n\r\u001b[7mbase64 'extras.signature' field) instead of the plain text, and\u001b[27m\r\n\r\u001b[7mJSON Schema '$schema' warnings were leaking into the terminal\u001b[27m\r\n\r\u001b[7moutput. Both fixed for a clean CLI experience.\"\u001b[27m\r\n\r\u001b[7mgit push origin main\u001b[27m"]
[223.861034, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\r\u001b]0;vnspo@vinicius: ~/agent-toolkit/templates/triagem-atendimento\u0007\u001b[01;32mvnspo@vinicius\u001b[00m:\u001b[01;34m~/agent-toolkit/templates/triagem-atendimento\u001b[00m$ git add -A\r\n\rgit commit -m \"fix(cli): extract plain text from MCP tool content and suppress noisy warnings\r\n\r\n\rmain.py was printing the raw MCP content blocks (including the\r\n\rbase64 'extras.signature' field) instead of the plain text, and\r\n\rJSON Schema '$schema' warnings were leaking into the terminal\r\n\routput. Both fixed for a clean CLI experience.\"\r\n\rgit push origin main\r\n"]
[223.862368, "o", "\u001b[?2004l\r"]
