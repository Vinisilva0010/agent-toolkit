[136.522788, "o", "\rcat > src/triagem_atendimento/main.py << 'FIMDOC'\r\n\rfrom __future__ import annotations\r\n\r\n\rimport asyncio\r\n\rimport logging\r\n\rimport sys\r\n\rimport warnings\r\n\r\n\rfrom langchain_core.messages import HumanMessage\r\n\rfrom langgraph.types import Command\r\n\r\n\rfrom triagem_atendimento.graph import build_graph\r\n\r\n\rlogging.disable(logging.WARNING)\r\n\rwarnings.filterwarnings(\"ignore\")\r\n\r\n\r\n\rdef _extract_text(content) -> str:\r\n\r    if isinstance(content, str):\r\n\r        return content\r\n\r    if isinstance(content, list):\r\n"]
[136.522915, "o", "\r        parts = []\r\n\r        for block in content:\r\n\r            if isinstance(block, dict) and block.get(\"type\") == \"text\":\r\n\r                parts.append(block.get(\"text\", \"\"))\r\n\r            elif isinstance(block, str):\r\n\r                parts.append(block)\r\n\r        return \"\".join(parts)\r\n\r    return str(content)\r\n\r\n\r\n\rasync def main() -> None:\r\n\r    graph = await build_graph()\r\n\r    config = {\"configurable\": {\"thread_id\": \"cli-session\"}}\r    print(\"Agente de triagem de atendimento. Digite sua mensagem (Ctrl+C para sair).\\n\")\r    try:\r        while True:\r            user_input = input(\"Você: \").strip()\r            if not user_input:\r\u001b[7m                continue\u001b[27m\r\u001b[7m            result = await graph.ainvoke(\u001b[27m\r\u001b[7m                {\"messages\": [HumanMessage(content=user_input)]}, config\u001b[27m\r\u001b[7m            )\u001b[27m\r\u001b[7m            while \"__interrupt__\" in result:\u001b[27m\r\u001b[7m                interrupt_info = result[\"__interrupt__\"][0].value\u001b[27m\r\u001b[7m                ticket_id = interrupt_info.get(\"ticket_id\", \"desconhecido\")\u001b[27m\r\u001b[7m                detalhes = _extract_text(interrupt_info.get(\"detalhes\", \"Sem detalhes.\"))\u001b[27m\r\u001b[7m                print(\"\\n[APROVAÇÃO HUMANA NECESSÁRIA]\")\u001b[27m\r\u001b[7m                print(f\"Ticket: {ticket_id}\")\u001b[27m\r\u001b[7m                print(f\"Detalhes: {detalhes}\")\u001b[27m\r\u001b[7m                resposta = input(\"Aprovar escalação? (s/n): \").strip().lower()\u001b[27m\r\u001b[7m                observacao = input(\"Observação (opcional): \").strip() or None\u001b[27m\r\u001b[7m                result = await graph.ainvoke(\u001b[27m\r\u001b[7m                    Command(\u001b[27m\r\u001b[7m                        resume={\"aprovado\": resposta == \"s\", \"observacao\": observacao}\u001b[27m\r\u001b[7m                    ),\u001b[27m\r\u001b[7m                    config,\u001b[27m\r\u001b[7m                )\u001b[27m\r\u001b[7m            resposta_final = _extract_text(result[\"messages\"][-1].content)\u001b[27m\r\u001b[7m            print(f\"\\nAgente: {resposta_final}\\n\")\u001b[27m\r\u001b[7m    except KeyboardInterrupt:\u001b[27m\r\u001b[7m        print(\"\\nAtendimento encerrado.\")\u001b[27m\r\u001b[7m        sys.exit(0)\u001b[27m\r\u001b[7mif __name__ == \"__main__\":\u001b[27m\r\u001b[7m    asyncio.run(main())\u001b[27m\r\u001b[7mFIMDOC\u001b[27m"]
[137.091689, "o", "\r                continue\r            result = await graph.ainvoke(\r                {\"messages\": [HumanMessage(content=user_input)]}, config\r            )\r            while \"__interrupt__\" in result:\r                interrupt_info = result[\"__interrupt__\"][0].value\r                ticket_id = interrupt_info.get(\"ticket_id\", \"desconhecido\")\r                detalhes = _extract_text(interrupt_info.get(\"detalhes\", \"Sem detalhes.\"))\r                print(\"\\n[APROVAÇÃO HUMANA NECESSÁRIA]\")\r                print(f\"Ticket: {ticket_id}\")\r                print(f\"Detalhes: {detalhes}\")\r                resposta = input(\"Aprovar escalação? (s/n): \").strip().lower()\r                observacao = input(\"Observação (opcional): \").strip() or None\r                result = await graph.ainvoke(\r                    Command(\r                        resume={\"aprovado\": resposta == \"s\", \"observacao\": observacao}\r                    ),\r                    config,\r                )\r            resposta_final = _extract_text(result[\"messages\"][-1].content)\r            print(f\"\\nAgente: {resposta_final}\\n\")\r    except KeyboardInterrupt:\r        print(\"\\nAtendimento encerrado.\")\r        sys.exit(0)\rif __name__ == \"__main__\":\r    asyncio.run(main())\rFIMDOC\r\n"]
